{
  "info": {
    "name": "Movie Standard Mission",
    "description": "01부터 순서대로 Send하세요. 테스트용 회원 2개를 실제 DB에 생성하고 memberId/ratingId를 자동 저장합니다. 마지막에 테스트 평점은 삭제하지만 회원은 남습니다. 백엔드를 먼저 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherMemberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ratingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 회원가입 성공 (201, memberId 저장)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set(\"runId\", runId);",
              "pm.collectionVariables.set(\"nicknameSuffix\", runId.slice(-8));",
              "[\"memberId\", \"otherMemberId\", \"ratingId\"].forEach(function (key) { pm.collectionVariables.unset(key); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON 응답\", function () { pm.response.to.be.json; });",
              "pm.test(\"회원 ID 저장 / 비밀번호 응답 제외\", function () { const d = pm.response.json(); pm.expect(d.isSuccess).to.eql(true); pm.expect(d.result.memberId).to.be.a(\"number\"); pm.expect(d.result).not.to.have.property(\"password\"); pm.collectionVariables.set(\"memberId\", d.result.memberId); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mission-{{runId}}@example.com\",\n  \"password\": \"TestPass1!\",\n  \"nickname\": \"미션{{nicknameSuffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
