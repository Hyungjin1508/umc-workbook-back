              "pm.test(\"평점 1개 / 수정값 반영 / 비밀번호 없음\", function () { const list = pm.response.json(); pm.expect(list).to.be.an(\"array\"); pm.expect(list).to.have.lengthOf(1); const rating = list.find(function (r) { return String(r.ratingId) === String(pm.collectionVariables.get(\"ratingId\")); }); pm.expect(rating).to.be.an(\"object\"); pm.expect(rating.score).to.eql(5); pm.expect(rating.comment).to.eql(\"수정한 후기\"); pm.expect(rating).not.to.have.property(\"password\"); });"
